{
	"appId": "com.resonantlabs.strainsense",
	"appName": "Strain Sense",
	"webDir": "dist",
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 0,
			"backgroundColor": "#0a0c09"
		}
	},
	"ios": {
		"backgroundColor": "#0a0c09",
		"contentInset": "never",
		"allowsLinkPreview": false,
		"scrollEnabled": true
	},
	"android": {
		"backgroundColor": "#0a0c09",
		"allowMixedContent": false
	},
	"packageClassList": [
		"CAPCameraPlugin",
		"PreferencesPlugin"
	]
}
