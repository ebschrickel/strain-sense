{
	"appId": "com.openpaw.strainsense",
	"appName": "Strain Sense",
	"webDir": "dist",
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 0,
			"backgroundColor": "#f3f1ea"
		}
	},
	"ios": {
		"backgroundColor": "#f3f1ea",
		"contentInset": "always",
		"allowsLinkPreview": false,
		"scrollEnabled": true
	},
	"android": {
		"backgroundColor": "#f3f1ea",
		"allowMixedContent": false
	},
	"packageClassList": [
		"CAPCameraPlugin",
		"PreferencesPlugin"
	]
}
